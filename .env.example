# Server Configuration
PORT=3000
NODE_ENV=development

# Google Sheets Configuration
# ใส่ ID ของ Google Spreadsheet (ดูได้จาก URL ของ Sheet)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account Credentials (แทนการใช้ credentials.json)
GOOGLE_SA_TYPE=service_account
GOOGLE_SA_PROJECT_ID=your_project_id
GOOGLE_SA_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_SA_CLIENT_ID=your_client_id
GOOGLE_SA_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com

FRONTEND_ORIGIN=*
